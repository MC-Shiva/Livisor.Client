        },
        {
            "m_Id": "b0efaee36441100661236081be8f4d40"
        },
        {
            "m_Id": "543ba59635fc3e411e0713f33c369ef6"
        },
        {
            "m_Id": "1a6e1d658979f478743e21f9beadb82e"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ScrollingTicker",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float2 uv = UV.xy * MainTex.scaleTranslate.xy + MainTex.scaleTranslate.zw;\nuv += Speed * Time;\nfloat4 sampleValue = SAMPLE_TEXTURE2D(MainTex.tex, MainTex.samplerstate, uv);\nBaseColor = sampleValue.rgb * Amplitude;\nAlpha = sampleValue.a;\n"
}

