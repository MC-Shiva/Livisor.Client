{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "961c7175b71c2da840ba471c29b2c17c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "BackScreen (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -430.0,
            "y": 20.0,
            "width": 360.0,
